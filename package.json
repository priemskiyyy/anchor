{
  "name": "anchor-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "dev": "pnpm --filter example-react dev",
    "dev:docs": "vitepress dev docs",
    "format": "prettier --write .",
    "lint:prettier": "prettier --check .",
    "lint:typescript": "tsc --noEmit && pnpm -r lint:typescript",
    "lint:eslint": "eslint .",
    "lint:docs": "tsc --noEmit -p docs/tsconfig.json",
    "test:lint": "node scripts/verify-lint-rules.mjs && node scripts/verify-no-any.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:examples": "pnpm build && playwright test -c examples/playwright.config.ts",
    "test:package": "node scripts/verify-packages.mjs",
    "test:mutation": "node scripts/mutate.mjs",
    "build:docs": "vitepress build docs && node scripts/build-demo.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:snippets": "node scripts/verify-snippets.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "check": "pnpm build && pnpm lint:typescript && pnpm lint:eslint && pnpm test:lint && pnpm lint:prettier && pnpm test:unit",
    "check:release": "pnpm check && pnpm lint:docs && pnpm build:docs && pnpm verify:docs && pnpm verify:snippets && pnpm test:package && pnpm verify:release && pnpm -r --if-present --filter './examples/*' build && pnpm test:mutation"
  },
  "devDependencies": {
    "@auth0/auth0-spa-js": "2.27.0",
    "@azure/msal-browser": "5.22.0",
    "@better-auth/expo": "1.7.6",
    "@clerk/backend": "3.18.1",
    "@clerk/clerk-js": "6.32.1",
    "@eslint/js": "9.39.4",
    "@expo/metro-runtime": "57.0.15",
    "@okta/okta-auth-js": "8.0.1",
    "@phosphor-icons/react": "2.1.10",
    "@playwright/test": "1.63.0",
    "@priemskiyyy/anchor": "workspace:*",
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/auth": "26.4.0",
    "@solidjs/testing-library": "0.8.10",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "22.20.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.0",
    "@workos-inc/authkit-js": "0.20.2",
    "@workos-inc/node": "10.13.0",
    "aws-amplify": "6.20.0",
    "better-auth": "1.7.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-svelte": "3.23.0",
    "eslint-plugin-vue": "10.11.0",
    "expo": "57.0.23",
    "expo-constants": "57.0.18",
    "expo-linking": "57.0.10",
    "expo-network": "57.0.2",
    "expo-secure-store": "57.0.4",
    "expo-web-browser": "57.0.3",
    "fast-check": "4.10.2",
    "firebase": "12.19.0",
    "firebase-admin": "14.4.0",
    "jsdom": "27.4.0",
    "keycloak-js": "26.2.4",
    "next-auth": "4.24.15",
    "oidc-client-ts": "3.5.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "publint": "0.3.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.3",
    "react-native-auth0": "5.11.1",
    "react-native-web": "0.21.2",
    "solid-js": "1.9.15",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "ts-pattern": "5.9.0",
    "tsdown": "0.22.14",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-solid": "2.11.14",
    "vitepress": "1.6.4",
    "vitest": "4.1.10",
    "vue": "3.5.42",
    "vue-tsc": "3.3.11",
    "zod": "4.1.12"
  }
}
