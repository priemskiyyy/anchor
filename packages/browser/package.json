{
  "name": "@priemskiyyy/anchor-browser",
  "version": "0.1.0",
  "description": "Browser lifecycle hints for Anchor: read the session again when the page becomes visible, the browser comes back online, or another tab's session changes.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/anchor.git",
    "directory": "packages/browser"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/anchor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../.. --project browser"
  },
  "peerDependencies": {
    "@priemskiyyy/anchor": ">=0.1.0 <0.2"
  },
  "devDependencies": {
    "@priemskiyyy/anchor": "workspace:*"
  },
  "keywords": [
    "browser",
    "visibility",
    "online",
    "broadcast-channel",
    "session",
    "typescript",
    "anchor"
  ],
  "homepage": "https://priemskiyyy.github.io/anchor/"
}
