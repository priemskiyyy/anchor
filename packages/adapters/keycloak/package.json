{
  "name": "@priemskiyyy/anchor-keycloak",
  "version": "0.1.0",
  "description": "Keycloak sessions for Anchor: logins, refreshes and logouts through the callbacks you assigned, access tokens refreshed on demand and the logout page on ending, over the keycloak-js instance you inject.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/anchor.git",
    "directory": "packages/adapters/keycloak"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/anchor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project keycloak"
  },
  "peerDependencies": {
    "@priemskiyyy/anchor": ">=0.1.0 <0.2",
    "keycloak-js": ">=26.0.0 <27"
  },
  "peerDependenciesMeta": {
    "keycloak-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@priemskiyyy/anchor": "workspace:*"
  },
  "keywords": [
    "keycloak",
    "oidc",
    "browser",
    "typescript",
    "anchor",
    "adapter"
  ],
  "homepage": "https://priemskiyyy.github.io/anchor/"
}
