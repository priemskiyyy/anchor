{
  "name": "@priemskiyyy/anchor-clerk-node",
  "version": "0.1.0",
  "description": "Clerk sessions for Anchor's server reads: each request authenticated with its organization and actor, and the headers Clerk wants set, over the @clerk/backend client you inject.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/anchor.git",
    "directory": "packages/adapters/clerk-node"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/anchor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project clerk-node"
  },
  "peerDependencies": {
    "@priemskiyyy/anchor": ">=0.1.0 <0.2",
    "@priemskiyyy/anchor-server": ">=0.1.0 <0.2",
    "@clerk/backend": ">=3.0.0 <4"
  },
  "peerDependenciesMeta": {
    "@clerk/backend": {
      "optional": true
    }
  },
  "devDependencies": {
    "@priemskiyyy/anchor": "workspace:*",
    "@priemskiyyy/anchor-clerk": "workspace:*",
    "@priemskiyyy/anchor-server": "workspace:*"
  },
  "keywords": [
    "clerk",
    "clerk-backend",
    "server",
    "ssr",
    "node",
    "typescript",
    "anchor",
    "adapter"
  ],
  "homepage": "https://priemskiyyy.github.io/anchor/"
}
