{
  "name": "@priemskiyyy/anchor-http",
  "version": "0.1.0",
  "description": "Your own backend's sessions for Anchor: the session your client reads, tokens bound to the session that asked, and its ending, over the functions you inject.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/anchor.git",
    "directory": "packages/adapters/http"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/anchor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project http"
  },
  "peerDependencies": {
    "@priemskiyyy/anchor": ">=0.1.0 <0.2"
  },
  "devDependencies": {
    "@priemskiyyy/anchor": "workspace:*"
  },
  "keywords": [
    "http",
    "fetch",
    "backend",
    "cookie-session",
    "react-native",
    "typescript",
    "anchor",
    "adapter"
  ],
  "homepage": "https://priemskiyyy.github.io/anchor/"
}
