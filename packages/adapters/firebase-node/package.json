{
  "name": "@priemskiyyy/anchor-firebase-node",
  "version": "0.1.0",
  "description": "Firebase Auth sessions for Anchor's server reads: each request's session cookie or ID token verified, over the firebase-admin Auth you inject.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/anchor.git",
    "directory": "packages/adapters/firebase-node"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/anchor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project firebase-node"
  },
  "peerDependencies": {
    "@priemskiyyy/anchor": ">=0.1.0 <0.2",
    "@priemskiyyy/anchor-server": ">=0.1.0 <0.2",
    "firebase-admin": ">=14.0.0 <15"
  },
  "peerDependenciesMeta": {
    "firebase-admin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@priemskiyyy/anchor": "workspace:*",
    "@priemskiyyy/anchor-firebase": "workspace:*",
    "@priemskiyyy/anchor-server": "workspace:*"
  },
  "keywords": [
    "firebase",
    "firebase-admin",
    "server",
    "ssr",
    "node",
    "typescript",
    "anchor",
    "adapter"
  ],
  "homepage": "https://priemskiyyy.github.io/anchor/"
}
