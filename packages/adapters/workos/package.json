{
  "name": "@priemskiyyy/anchor-workos",
  "version": "0.1.1",
  "description": "WorkOS AuthKit sessions for Anchor: the user and organization, and access tokens refreshed on demand, over the AuthKit client you inject.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/anchor.git",
    "directory": "packages/adapters/workos"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/anchor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project workos"
  },
  "peerDependencies": {
    "@priemskiyyy/anchor": ">=0.1.0 <0.2",
    "@workos-inc/authkit-js": ">=0.20.2 <1"
  },
  "peerDependenciesMeta": {
    "@workos-inc/authkit-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@priemskiyyy/anchor": "workspace:*"
  },
  "keywords": [
    "workos",
    "authkit",
    "sso",
    "browser",
    "typescript",
    "anchor",
    "adapter"
  ],
  "homepage": "https://priemskiyyy.github.io/anchor/"
}
