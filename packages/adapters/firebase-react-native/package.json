{
  "name": "@priemskiyyy/anchor-firebase-react-native",
  "version": "0.1.1",
  "description": "Firebase Authentication sessions for Anchor on React Native: the signed-in user observed through onIdTokenChanged and its ID tokens, over the @react-native-firebase/auth Auth instance you inject.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/anchor.git",
    "directory": "packages/adapters/firebase-react-native"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/anchor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project firebase-react-native"
  },
  "peerDependencies": {
    "@priemskiyyy/anchor": ">=0.1.0 <0.2",
    "@react-native-firebase/auth": ">=26.0.0 <27"
  },
  "peerDependenciesMeta": {
    "@react-native-firebase/auth": {
      "optional": true
    }
  },
  "devDependencies": {
    "@priemskiyyy/anchor": "workspace:*"
  },
  "keywords": [
    "firebase",
    "react-native-firebase",
    "react-native",
    "expo",
    "typescript",
    "anchor",
    "adapter"
  ],
  "homepage": "https://priemskiyyy.github.io/anchor/"
}
