{
  "name": "@priemskiyyy/anchor-authjs",
  "version": "0.1.1",
  "description": "Auth.js sessions for Anchor: the cookie session, read and ended without a redirect, over the next-auth/react client you inject.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/anchor.git",
    "directory": "packages/adapters/authjs"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/anchor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project authjs"
  },
  "peerDependencies": {
    "@priemskiyyy/anchor": ">=0.1.0 <0.2",
    "next-auth": ">=4.24.0 <5"
  },
  "peerDependenciesMeta": {
    "next-auth": {
      "optional": true
    }
  },
  "devDependencies": {
    "@priemskiyyy/anchor": "workspace:*"
  },
  "keywords": [
    "authjs",
    "next-auth",
    "nextjs",
    "cookie-session",
    "browser",
    "typescript",
    "anchor",
    "adapter"
  ],
  "homepage": "https://priemskiyyy.github.io/anchor/"
}
