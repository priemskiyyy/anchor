{
  "name": "@priemskiyyy/anchor-svelte",
  "version": "0.1.1",
  "description": "Svelte bindings for Anchor: a provider component, and utilities that read the Anchor and its session state, with selectors, and never start, read or mint anything.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/anchor.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/anchor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.fixture.*",
    "!dist/**/*.contracts.*",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "lint:typescript": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../.. --project svelte --project svelte-ssr"
  },
  "peerDependencies": {
    "@priemskiyyy/anchor": ">=0.1.0 <0.2",
    "svelte": ">=5.7.0 <6"
  },
  "devDependencies": {
    "@priemskiyyy/anchor": "workspace:*"
  },
  "keywords": [
    "svelte",
    "runes",
    "session",
    "authentication",
    "typescript",
    "anchor"
  ],
  "homepage": "https://priemskiyyy.github.io/anchor/",
  "svelte": "./dist/index.js"
}
